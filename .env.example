DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUDIT_IP_SALT=replace-with-a-long-random-secret
FORUM_OWNER_USERNAME=CloudOwner
FORUM_OWNER_PASSWORD=replace-with-at-least-12-random-characters
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

